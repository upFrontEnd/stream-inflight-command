{
  "name": "stream-inflight-command",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n worker,ui -c blue,green \"bun run dev:worker\" \"bun run dev:ui\"",
    "dev:worker": "wrangler dev --config worker/wrangler.toml",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "dev:ui": "vite --config ui/vite.config.js",
    "build:ui": "vite build --config ui/vite.config.js",
    "preview:ui": "vite preview --config ui/vite.config.js",
    "bot": "bun scripts/bot-watchdog.mjs",
    "bot:once": "bun --env-file=bot/.env bot/src/index.js",
    "bot:token": "bun --env-file=bot/.env bot/src/get-token.js"
  },
  "dependencies": {
    "tmi.js": "^1.8.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.5",
    "sass": "^1.105.0",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  }
}

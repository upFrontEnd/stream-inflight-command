{
  "name": "stream-inflight-command",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/with-node22.sh concurrently -n worker,ui -c blue,green \"bun run dev:worker\" \"bun run dev:ui\"",
    "dev:worker": "./scripts/with-node22.sh wrangler dev --config worker/wrangler.toml",
    "deploy:worker": "./scripts/with-node22.sh wrangler deploy --config worker/wrangler.toml",
    "dev:ui": "./scripts/with-node22.sh vite --config ui/vite.config.js",
    "build:ui": "./scripts/with-node22.sh vite build --config ui/vite.config.js",
    "preview:ui": "./scripts/with-node22.sh vite preview --config ui/vite.config.js",
    "bot": "bun --env-file=bot/.env bot/index.js"
  },
  "dependencies": {
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "sass": "^1.105.0",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  }
}

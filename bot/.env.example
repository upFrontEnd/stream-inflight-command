# Client ID de ton appli créée sur https://dev.twitch.tv/console/apps/create
# (nécessaire uniquement pour générer le token via `bun run bot:token`)
TWITCH_CLIENT_ID=your_client_id

TWITCH_BOT_USERNAME=your_bot_account_username
# Généré par `bun run bot:token`, ne pas éditer à la main
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_CHANNEL=your_channel_name
OVERLAY_PORT=4242

# URL du Worker SimBrief pour !appareil / !plandevol / !meteo.
# http://localhost:8787 en dev (bun run dev:worker), l'URL Cloudflare une fois déployé.
WORKER_URL=http://localhost:8787

# Intervalle entre deux messages d'annonce (Discord, follow, etc.), en minutes.
ANNOUNCE_INTERVAL_MINUTES=30

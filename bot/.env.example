# Client ID de ton appli créée sur https://dev.twitch.tv/console/apps/create
# (nécessaire uniquement pour générer le token via `bun run bot:token`)
TWITCH_CLIENT_ID=your_client_id
# Secret de l'appli (type "Confidential") : rend le refresh token permanent.
# Sans lui (appli "Public"), le refresh token expire au bout de 30 jours.
TWITCH_CLIENT_SECRET=your_client_secret
# Fichier où stocker les tokens. Sur Railway : monter un volume sur /data et
# mettre /data/twitch-tokens.json pour qu'ils survivent aux redéploiements.
# TOKEN_STORE_PATH=/data/twitch-tokens.json

TWITCH_BOT_USERNAME=your_bot_account_username
# Ces deux lignes sont générées et mises à jour automatiquement par
# `bun run bot:token` (une fois), puis par le bot lui-même à chaque
# rafraîchissement (l'access token n'est valable que 4h) : ne pas éditer à la
# main.
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_CHANNEL=your_channel_name
OVERLAY_PORT=4242

# URL du Worker SimBrief pour !appareil / !plandevol / !meteo.
# http://localhost:8787 en dev (bun run dev:worker), l'URL Cloudflare une fois déployé.
WORKER_URL=http://localhost:8787

# Intervalle entre deux messages d'annonce (Discord, follow, etc.), en minutes.
ANNOUNCE_INTERVAL_MINUTES=30
